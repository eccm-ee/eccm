{
  // eccm: the site for eccm.ee while it is built, served as static assets.
  // Session 0 of plans/plan-eccm-setup.md: there is no Worker script yet, the
  // pages and their files under public/ are the whole site, and public/ is the
  // SOURCE, not a build output.
  //
  // Two environments from day one, and nothing deploys without one:
  //   npx wrangler deploy --env staging      this account, https://eccm.positron.studio/
  //   npx wrangler deploy --env production   ECCM's own account and eccm.ee, once both exist
  "name": "eccm",
  // session 1 of plans/plan-eccm-cms-step-1.md: the script behind the assets,
  // reached only by paths no file under public/ answers
  "main": "src/index.mjs",
  "account_id": "dc1ee8d72a1fb7da857c46479a8503b8",
  // the newest date the workerd of wrangler 4.107.0 supports, and 4.107.0 is
  // the version whose binary this managed laptop lets run (CLAUDE.md)
  "compatibility_date": "2026-07-08",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    // /event serves event.html, the way positron's edge did for /eccm/event
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  // the share images' faces (src/og/render.mjs), bundled as bytes; the
  // resvg wasm needs no rule, a .wasm import is a compiled module by default
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  // SQLite-backed, the shape positron's workers/items proved
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Items"] }, { "tag": "v2", "new_sqlite_classes": ["Radio"] }],
  "env": {
    "staging": {
      "name": "eccm-staging",
      // the same line positron's workers use for <name>.positron.studio;
      // Cloudflare writes the DNS record and the certificate on deploy
      "routes": [{ "pattern": "eccm.positron.studio", "custom_domain": true }],
      "workers_dev": true,
      // the database, created 2026-09-27 with wrangler d1 create eccm-staging
      // on this account; the same name serves the local file under wrangler dev
      "d1_databases": [{ "binding": "DB", "database_name": "eccm-staging", "database_id": "3be30799-baa1-4844-937c-b4c6858fc915", "migrations_dir": "migrations" }],
      // the uploaded pictures, one original per sha256 (src/media.mjs), created
      // 2026-09-30 with wrangler r2 bucket create eccm-media-staging
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "eccm-media-staging" }],
      // Image Transformations are on for positron.studio since 2026-09-30
      // (dashboard, Images, Transformations, "This zone only"); "off" makes
      // src/render/pic.mjs draw the originals, as a zone without them needs
      // the notices of /items (src/items.mjs), one Durable Object holding
      // the list, its alarm and the browsers' subscriptions, since 2026-10-01
      // and the live shows kept from the station (src/radio.mjs), since 2026-10-02
      "durable_objects": { "bindings": [{ "name": "ITEMS", "class_name": "Items" }, { "name": "RADIO", "class_name": "Radio" }] },
      // VAPID_PUBLIC is the public half of the key Web Push is signed with
      // (src/push.mjs) and VAPID_SUB the contact a push service sees; the
      // private half is the secret VAPID_JWK (wrangler secret put VAPID_JWK
      // --env staging). A new key means every browser subscribes again.
      // the newsletter's mail (src/mail.mjs): the send_email binding, the
      // address it sends from on eccm.positron.studio, the sending domain the
      // owner onboarded 2026-10-01 (Email Sending, Enabled, 1,000 a day), and
      // the cron that drains what did not go at once.
      "send_email": [{ "name": "EMAIL" }],
      "triggers": { "crons": ["*/10 * * * *"] },
      "vars": { "IMAGE_TRANSFORMS": "on", "MAIL_FROM": "ECCM <uudiskiri@eccm.positron.studio>", "VAPID_PUBLIC": "BMFK4ASgBxY0RNxBPRoJTUHFf3pTkyx9lR3jIYG_miJdtrc7a_moyVkig2QlFVBr5d5BuacnyV6skIeaxvTGHM4", "VAPID_SUB": "https://eccm.positron.studio/" }
    },
    "production": {
      "name": "eccm"
      // ECCM's account_id, eccm.ee and www.eccm.ee go here at cutover
      // (plans/plan-eccm-setup.md section 8); until then this deploys nowhere
    }
  }
}
